PORT=5000
API_HOST=127.0.0.1
MONGO_URI=mongodb://127.0.0.1:27017/your_database_name
JWT_SECRET=replace_with_a_long_random_jwt_secret
JWT_EXPIRES_IN=7d
APP_TIME_ZONE=Asia/Manila
# Required in production for private payment proofs and automatic backups.
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_r2_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_your_r2_secret_access_key
CLIENT_ORIGIN=http://localhost:5173
RESET_URL_BASE=http://localhost:5173
PASSWORD_RESET_PATH=/reset-password
PIN_RESET_PATH=/reset-pin
PASSWORD_RESET_TTL_MINUTES=15
PIN_RESET_TTL_MINUTES=15
PASSWORD_MIN_LENGTH=8
PIN_LENGTH=6
AUTH_FORGOT_WINDOW_MINUTES=15
AUTH_FORGOT_MAX_ATTEMPTS=5
AUTH_RESET_WINDOW_MINUTES=15
AUTH_RESET_MAX_ATTEMPTS=5
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your_smtp_username
MAIL_PASS=replace_with_your_smtp_password
MAIL_FROM=no-reply@example.com
SEED_SUPERADMIN_USERNAME=your_seed_superadmin_username
SEED_SUPERADMIN_PASSWORD=replace_with_your_seed_superadmin_password
SEED_SUPERADMIN_PIN=replace_with_your_seed_superadmin_pin
SMOKE_BASE_URL=http://127.0.0.1:5000
SMOKE_USERNAME=your_smoke_test_username
SMOKE_PASSWORD=replace_with_your_smoke_test_password
SMOKE_PIN=replace_with_your_smoke_test_pin
