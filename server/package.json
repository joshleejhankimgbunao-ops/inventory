{
  "name": "server",
  "version": "1.0.0",
  "description": "Inventory backend API",
  "main": "src/server.js",
  "scripts": {
    "mongo:ensure": "powershell -ExecutionPolicy Bypass -File .\\scripts\\powershell\\ensure-mongo-running.ps1",
    "dev": "npm run mongo:ensure && node scripts/runWithEnv.js local dev",
    "dev:local": "npm run dev",
    "dev:atlas": "node scripts/runWithEnv.js atlas dev",
    "start": "npm run mongo:ensure && node src/server.js",
    "start:local": "node scripts/runWithEnv.js local start",
    "start:atlas": "node scripts/runWithEnv.js atlas start",
    "sync:users:local-to-atlas": "node scripts/syncUsersLocalToAtlas.js",
    "seed": "node src/scripts/seed.js",
    "seed:reset": "node src/scripts/seed.js --reset",
    "migrate:products:phase6": "node scripts/migrateProductsPhase6.js",
    "migrate:primary-superadmin": "node scripts/designatePrimarySuperAdmin.js",
    "sync:categories:from-products": "node scripts/syncCategoriesFromProducts.js",
    "smoke": "node scripts/smokeTest.js",
    "test:auth-flow": "node scripts/integrationAuthFlowTest.js",
    "test:auto-print": "node --test test/autoPrintPreference.test.js",
    "test:inventory-reason": "node --test test/inventoryAdjustmentReason.test.js",
    "test:product-sku": "node --test test/productSkuBehavior.test.js",
    "test:receipt-reprint": "node --test test/receiptPrinterPayload.test.js test/saleHistoryReceipt.test.js",
    "test:automatic-backup": "node --test test/automaticBackupService.test.js",
    "test:credit-flow": "node scripts/integrationCreditFlowTest.js",
    "test:security": "node --test test/securityConfig.test.js test/settingsPublicProjection.test.js test/emailLogging.test.js",
    "security:rotate-jwt": "node scripts/rotateJwtSecret.js",
    "db:backup": "powershell -ExecutionPolicy Bypass -File .\\scripts\\powershell\\backup-db.ps1",
    "db:restore": "powershell -ExecutionPolicy Bypass -File .\\scripts\\powershell\\restore-db.ps1",
    "test": "npm run smoke"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
